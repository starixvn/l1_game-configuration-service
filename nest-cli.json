{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      { "include": "**/*.yml", "watchAssets": true, "outDir": "dist/src" },
      { "include": "../static/**/*", "watchAssets": true, "outDir": "dist/src/static" }
    ]
  }
}
